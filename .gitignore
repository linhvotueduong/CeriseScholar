# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/src/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code local settings
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# build/backup snapshots (auto-generated, not source)
/.next.backup-*/
/.next-*/

# local browser verification artifacts
/.playwright-cli/

# claude code worktrees
/.claude/worktrees/

# supabase local cli temp
/supabase/.temp/

# SwiftPM Local Research Host build products
/apps/local-research-host/.build/
/apps/local-research-host/dist/
