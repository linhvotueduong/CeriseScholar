{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    ".next/cache",
    ".next/server",
    ".next/static",
    ".next/types/**/* 2.ts",
    ".next/types/**/* 3.ts",
    ".next/types/**/* 4.ts",
    ".next/types/**/* 5.ts",
    ".next/dev/types/**/* 2.ts",
    ".next/dev/types/**/* 3.ts",
    ".next/dev/types/**/* 4.ts",
    ".next/dev/types/**/* 5.ts",
    "src/.next",
    ".local-artifacts"
  ]
}
